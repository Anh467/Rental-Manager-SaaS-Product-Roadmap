{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "External": {
      "AllowedProviders": [ "oidc" ],
      "DefaultScheme": "oidc",
      "AllowFirstLoginProvisioning": true,
      "AllowRequestBodyLogin": false,
      "PostLoginRedirectPath": "/login/callback",
      "Oidc": {
        "Authority": "",
        "ClientId": "",
        "ClientSecret": "",
        "CallbackPath": "/signin-oidc",
        "SignedOutCallbackPath": "/signout-callback-oidc",
        "RequireHttpsMetadata": true
      }
    }
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Provider": "oidc",
    "Subject": "",
    "Email": "",
    "DisplayName": ""
  },
  "AuthRateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "DataProtection": {
    "KeyRingPath": ""
  }
}
