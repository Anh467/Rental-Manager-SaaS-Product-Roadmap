<Project Sdk="Microsoft.Build.Sql/2.0.0">
  <PropertyGroup>
    <Name>RentalManager.Database.SQLServer</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <SqlServerVerification>False</SqlServerVerification>
    <!-- Cross-database references are not used, so unresolved references are errors. -->
    <SuppressTSqlWarnings>
    </SuppressTSqlWarnings>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <ProjectGuid>{7874bda0-1a8e-4e3d-bdf7-9388b230a258}</ProjectGuid>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!--
      Pin 2.0.0 for Visual Studio 2026: SDK 2.1+ passes AutomaticIndexCompaction /
      AcceleratedDatabaseRecovery to SqlBuildTask, but VS 18 DAC does not support
      those parameters yet (microsoft/DacFx#776).
    -->
    <SkipCheckForNewSDKVersion>true</SkipCheckForNewSDKVersion>
    <!--
      Visual Studio Solution Explorer only shows SQL files that are listed
      explicitly in this project. Disable the SDK default glob and include
      schema objects here so they appear in Solution Explorer and still build.
    -->
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>
  <ItemGroup>
    <Build Include="Schema\**\*.sql" />
    <Build Include="Schemas\**\*.sql" />
    <None Include="Scripts\**\*.sql" />
    <PostDeploy Include="Scripts\PostDeployment\PostDeployment.sql" />
    <None Remove="Scripts\PostDeployment\PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Schema\" />
    <Folder Include="Schema\Dbo\" />
    <Folder Include="Schema\Dbo\Tables\" />
    <Folder Include="Schema\Dbo\Procedures\" />
    <Folder Include="Schema\Org\" />
    <Folder Include="Schema\Org\Tables\" />
    <Folder Include="Schema\Org\Functions\" />
    <Folder Include="Schema\Org\SecurityPolicies\" />
    <Folder Include="Schemas\" />
    <Folder Include="Scripts\" />
    <Folder Include="Scripts\PostDeployment\" />
    <Folder Include="Scripts\PostDeployment\SeedDatas\" />
  </ItemGroup>
  <!--
    Classic SSDT/VS design-time builds often force net472 for .sqlproj, but
    Microsoft.Build.Sql restores package assets for netstandard2.1. Align the
    TFM before NuGet asset resolution so NETSDK1005 does not fire.
  -->
  <Target Name="AlignSqlSdkTargetFramework" BeforeTargets="ResolvePackageAssets;ResolvePackageAssetsDesignTime;CollectPackageReferences">
    <PropertyGroup>
      <TargetFramework>netstandard2.1</TargetFramework>
      <TargetFrameworks>
      </TargetFrameworks>
      <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
      <TargetFrameworkVersion>v2.1</TargetFrameworkVersion>
      <TargetFrameworkMoniker>.NETStandard,Version=v2.1</TargetFrameworkMoniker>
      <NuGetTargetMoniker>.NETStandard,Version=v2.1</NuGetTargetMoniker>
      <NuGetTargetFramework>netstandard2.1</NuGetTargetFramework>
    </PropertyGroup>
  </Target>
</Project>